{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mock db_reset",
      // 開発用の db(diary_dev)を消して schema.py から作り直し、今の前後 10 年に散らした作り物の日記とコメントを入れる。
      // 画面で試しに書いた日記・コメントも消える
      "command": ".venv/bin/python",
      "args": ["-m", "tool.dev.reset_db"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONPATH": "${workspaceFolder}",
          "DIARY_DEV_DATABASE_URL": "postgresql+psycopg://diary:diary@127.0.0.1:55433/diary_dev"
        }
      },
      "windows": {
        "command": ".venv\\Scripts\\python.exe"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": false
      }
    },
    {
      "label": "mock app",
      // 日記の画面を、開発用の db(diary_dev)に向けて起こす。API(uvicorn :8766)と画面(next dev :3001)を一緒に起こし、
      // ブラウザで http://localhost:3001 を開く。止めるときはターミナルで Ctrl+C(両方止まる)。行は先にタスク「mock db_reset」で入れる
      "command": ".venv/bin/python",
      "args": ["-m", "gui.dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONPATH": "${workspaceFolder}",
          "DIARY_DATABASE_URL": "postgresql+psycopg://diary:diary@127.0.0.1:55433/diary_dev",
          "DIARY_DATABASE_IAM_AUTH": "0"
        }
      },
      // npm は nvm で入れており、nvm は ~/.bashrc(対話シェルでだけ読まれる)で PATH に足されるので、対話モードで起こす
      "linux": {
        "options": {
          "shell": {
            "executable": "bash",
            "args": ["-ic"]
          }
        }
      },
      "windows": {
        "command": ".venv\\Scripts\\python.exe"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": true
      }
    },
    {
      "label": "mock browser",
      "type": "shell",
      // 「mock app」で API・画面がすでに起きている前提で、ブラウザだけ開く(gui.dev --browser-only)
      "command": ".venv/bin/python",
      "args": ["-m", "gui.dev", "--browser-only"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "windows": {
        "command": ".venv\\Scripts\\python.exe"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "git push",
      "type": "shell",
      // 今のブランチの変更をすべて日時のメッセージでコミットし、pull --rebase してから push する。
      // 公開リポジトリなので、構築の値(アカウント ID・リソースの ID など)が紛れていないかを先に確かめておく(.claude/docs/aws.md)
      "command": "m=\"$(date '+%Y-%m-%d %H:%M:%S')\"; git add -A; git commit -m \"$m\"; git pull --rebase && git push",
      "windows": {
        "command": "$m = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'; git add -A; git commit -m $m; git pull --rebase; if ($?) { git push }",
        "options": {
          "cwd": "${workspaceFolder}",
          "shell": {
            "executable": "powershell.exe",
            "args": ["-NoProfile", "-Command"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      }
    }
  ]
}
