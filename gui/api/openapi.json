{
  "openapi": "3.1.0",
  "info": {
    "title": "all-diary API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/ping": {
      "get": {
        "summary": "Ping",
        "operationId": "ping_api_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "type": "object",
                  "title": "Response Ping Api Ping Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/diaries": {
      "get": {
        "summary": "List Diaries",
        "description": "日本時間の `start_date` から `end_date` まで(両端を含む)の日記を、コメント付きで時刻の順に返す。",
        "operationId": "list_diaries_api_diaries_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Date"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DiaryRecord"
                  },
                  "title": "Response List Diaries Api Diaries Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Commit Diary",
        "operationId": "commit_diary_api_diaries_post",
        "parameters": [
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiaryCreateForm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiaryRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/diaries/{diary_id}": {
      "get": {
        "summary": "Read Diary",
        "operationId": "read_diary_api_diaries__diary_id__get",
        "parameters": [
          {
            "name": "diary_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Diary Id"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiaryRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/diaries/{diary_id}/comments": {
      "get": {
        "summary": "List Comments",
        "operationId": "list_comments_api_diaries__diary_id__comments_get",
        "parameters": [
          {
            "name": "diary_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Diary Id"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommentRecord"
                  },
                  "title": "Response List Comments Api Diaries  Diary Id  Comments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/comments/{comment_id}": {
      "get": {
        "summary": "Read Comment",
        "operationId": "read_comment_api_comments__comment_id__get",
        "parameters": [
          {
            "name": "comment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Comment Id"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/comments": {
      "post": {
        "summary": "Commit Comment",
        "operationId": "commit_comment_api_comments_post",
        "parameters": [
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentCreateForm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/csv/{kind}": {
      "post": {
        "summary": "Import Csv",
        "description": "CSV を取り込む。コメントは、先に取り込んだ日記の CSV の id を `diary_id` で指す。",
        "operationId": "import_csv_api_csv__kind__post",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "diary",
                "comment"
              ],
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CsvImportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Imported"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Export Csv",
        "description": "取り込み直せる形の CSV を返す。",
        "operationId": "export_csv_api_csv__kind__get",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "diary",
                "comment"
              ],
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/legacy-db/summary": {
      "post": {
        "summary": "Summarize Legacy Db",
        "description": "以前の SQLite の db ファイル(本文にそのまま)に、誰の日記が何件あるか。db には触れない。",
        "operationId": "summarize_legacy_db_api_legacy_db_summary_post",
        "parameters": [
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyDbSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/legacy-db/import": {
      "post": {
        "summary": "Import Legacy Db",
        "description": "以前の SQLite の db ファイル(本文にそのまま)から、`source_user_id` の日記とコメントを取り込む。",
        "operationId": "import_legacy_db_api_legacy_db_import_post",
        "parameters": [
          {
            "name": "source_user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source User Id"
            }
          },
          {
            "name": "x-diary-user",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Diary-User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyImported"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommentCreateForm": {
        "properties": {
          "diary_id": {
            "type": "integer",
            "title": "Diary Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "diary_id",
          "text"
        ],
        "title": "CommentCreateForm"
      },
      "CommentRecord": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "diary_id": {
            "type": "integer",
            "title": "Diary Id"
          },
          "time": {
            "type": "string",
            "title": "Time"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "diary_id",
          "time",
          "text"
        ],
        "title": "CommentRecord"
      },
      "CsvImportRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CsvImportRequest"
      },
      "DiaryCreateForm": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "DiaryCreateForm"
      },
      "DiaryRecord": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "time": {
            "type": "string",
            "title": "Time"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "comments": {
            "items": {
              "$ref": "#/components/schemas/CommentRecord"
            },
            "type": "array",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "time",
          "text",
          "comments"
        ],
        "title": "DiaryRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "dialect": {
            "type": "string",
            "title": "Dialect"
          }
        },
        "type": "object",
        "required": [
          "dialect"
        ],
        "title": "Health"
      },
      "Imported": {
        "properties": {
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped"
          }
        },
        "type": "object",
        "required": [
          "added",
          "skipped"
        ],
        "title": "Imported"
      },
      "LegacyDbSummary": {
        "properties": {
          "users": {
            "items": {
              "$ref": "#/components/schemas/LegacyUser"
            },
            "type": "array",
            "title": "Users"
          },
          "unlinked_comments": {
            "type": "integer",
            "title": "Unlinked Comments"
          }
        },
        "type": "object",
        "required": [
          "users",
          "unlinked_comments"
        ],
        "title": "LegacyDbSummary"
      },
      "LegacyImported": {
        "properties": {
          "diaries": {
            "$ref": "#/components/schemas/Imported"
          },
          "comments": {
            "$ref": "#/components/schemas/Imported"
          }
        },
        "type": "object",
        "required": [
          "diaries",
          "comments"
        ],
        "title": "LegacyImported"
      },
      "LegacyUser": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "diaries": {
            "type": "integer",
            "title": "Diaries"
          },
          "comments": {
            "type": "integer",
            "title": "Comments"
          },
          "first_time": {
            "type": "string",
            "title": "First Time"
          },
          "last_time": {
            "type": "string",
            "title": "Last Time"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "diaries",
          "comments",
          "first_time",
          "last_time"
        ],
        "title": "LegacyUser",
        "description": "以前の db に日記を持つ人一人ぶん。`user_id` は以前の Cognito のユーザーの sub。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
